datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. IDENTITY & RBAC
// -------------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  code        String           @unique // SUPER_ADMIN, HO_ADMIN, BRANCH_MANAGER, MAKER, CHECKER, TELLER, etc.
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdCustomers Customer[]       @relation("CustomerCreatedBy")
  approvedCustomers Customer[]      @relation("CustomerApprovedBy")
  makerRequests    ApprovalQueue[]  @relation("MakerRequests")
  checkerRequests  ApprovalQueue[]  @relation("CheckerRequests")
  assignedCounters BranchCounter[]
  tellerTills      TellerTill[]
  makerTransactions Transaction[]   @relation("TransactionMaker")
  checkerTransactions Transaction[] @relation("TransactionChecker")
}

// -------------------------------------------------------------
// 2. ORGANIZATION & BRANCH STRUCTURE
// -------------------------------------------------------------

model Organization {
  id                 String   @id @default(uuid())
  name               String
  registrationNumber String   @unique
  headOfficeAddress  String
  contactEmail       String
  contactPhone       String
  panNumber          String?
  gstNumber          String?
  establishedDate    DateTime?
  branches           Branch[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Branch {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  code           String          @unique
  name           String
  ifscCode       String?
  micrCode       String?
  address        String
  city           String
  state          String
  pincode        String
  phone          String
  email          String
  isActive       Boolean         @default(true)
  users          User[]
  counters       BranchCounter[]
  businessDates  BusinessDate[]
  customers      Customer[]
  approvalQueues ApprovalQueue[]
  accounts       Account[]
  tellerTills    TellerTill[]
  transactions   Transaction[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model BranchCounter {
  id            String       @id @default(uuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counterNumber String
  counterName   String
  assignedUserId String?
  assignedUser  User?        @relation(fields: [assignedUserId], references: [id])
  isActive      Boolean      @default(true)
  tellerTills   TellerTill[]
  createdAt     DateTime     @default(now())
}

model BusinessDate {
  id              String    @id @default(uuid())
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentDate     String    // YYYY-MM-DD
  status          String    @default("OPEN") // OPEN, CUTOFF, CLOSED
  openedByUserId  String?
  closedByUserId  String?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?

  @@unique([branchId, currentDate])
}

// -------------------------------------------------------------
// 3. CUSTOMER & MEMBER MASTER
// -------------------------------------------------------------

model Customer {
  id                 String            @id @default(uuid())
  customerNumber     String            @unique
  customerType       String            @default("INDIVIDUAL")
  isMember           Boolean           @default(false)
  memberNumber       String?           @unique
  membershipDate     DateTime?
  memberStatus       String?
  
  title              String            @default("Mr.")
  firstName          String
  middleName         String?
  lastName           String
  dob                String
  gender             String
  maritalStatus      String?
  fatherOrSpouseName String?
  occupation         String?
  annualIncome       Float?            @default(0)
  pan                String?
  aadhaarLast4       String?
  phone              String
  email              String?

  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id])
  riskCategory       String            @default("LOW")
  status             String            @default("PENDING_KYC")

  createdByUserId    String?
  createdBy          User?             @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId   String?
  approvedBy         User?             @relation("CustomerApprovedBy", fields: [approvedByUserId], references: [id])

  addresses          CustomerAddress[]
  nominees           CustomerNominee[]
  kycDocuments       KycDocument[]
  memberShares       MemberShare[]
  accounts           Account[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pincode     String
  isPrimary   Boolean  @default(true)
}

model CustomerNominee {
  id                   String   @id @default(uuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                 String
  relationship         String
  dob                  String?
  age                  Int?
  phone                String?
  address              String?
  allocationPercentage Float    @default(100.0)
  isMinor              Boolean  @default(false)
  guardianName         String?
  guardianRelation     String?
  guardianPhone        String?
}

model MemberShare {
  id                     String   @id @default(uuid())
  customerId             String
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shareCertificateNumber String   @unique
  distinctFrom           Int
  distinctTo             Int
  totalShares            Int
  faceValue              Float    @default(10.0)
  totalAmount            Float
  issueDate              DateTime @default(now())
  status                 String   @default("ACTIVE")
}

model KycDocument {
  id                  String    @id @default(uuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType        String
  documentNumber      String
  documentUrl         String?
  mimeType            String?   @default("application/pdf")
  version             Int       @default(1)
  status              String    @default("PENDING")
  verifiedByUserId    String?
  verifiedAt          DateTime?
  verificationRemarks String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ApprovalQueue {
  id            String    @id @default(uuid())
  module        String    // CUSTOMER, KYC, MEMBER, ACCOUNT, TRANSACTION
  entityId      String
  actionType    String
  payloadJson   String
  status        String    @default("PENDING")
  makerUserId   String
  maker         User      @relation("MakerRequests", fields: [makerUserId], references: [id])
  makerRemarks  String?
  checkerUserId String?
  checker       User?     @relation("CheckerRequests", fields: [checkerUserId], references: [id])
  checkerRemarks String?
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
}

// -------------------------------------------------------------
// 6. PHASE 2: PRODUCTS, CASA & DEPOSITS (SECTIONS 6 & 29)
// -------------------------------------------------------------

model Product {
  id                    String    @id @default(uuid())
  code                  String    @unique // e.g. SB001, CA001, FD001, RD001
  name                  String
  category              String    // SAVINGS, CURRENT, FIXED_DEPOSIT, RECURRING_DEPOSIT
  description           String?
  currency              String    @default("INR")
  minBalance            Float     @default(500.0)
  interestRate          Float     @default(0.0) // Annual interest rate percentage
  compoundingFrequency  String    @default("QUARTERLY") // MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY
  tenureMinMonths       Int?      @default(0)
  tenureMaxMonths       Int?      @default(120)
  prematurePenaltyRate  Float?    @default(1.0) // Penalty deducted if broken early
  glAccountCode         String    // e.g. GL-2001 (Customer Deposit Liability)
  isActive              Boolean   @default(true)
  accounts              Account[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Account {
  id                    String              @id @default(uuid())
  accountNumber         String              @unique // SB-YYYY-XXXXX, CA-..., FD-..., RD-...
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id])
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  currency              String              @default("INR")
  ledgerBalance         Float               @default(0.0)
  availableBalance      Float               @default(0.0)
  lienAmount            Float               @default(0.0)
  status                String              @default("ACTIVE") // ACTIVE, DORMANT, FROZEN, CLOSED
  openedDate            DateTime            @default(now())
  closedDate            DateTime?
  interestAccrued       Float               @default(0.0)
  nomineeName           String?
  nomineeRelation       String?
  termDepositDetail     TermDepositDetail?
  sourceTransactions    Transaction[]       @relation("SourceAccount")
  destTransactions      Transaction[]       @relation("DestinationAccount")
  transactionLines      TransactionLine[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model TermDepositDetail {
  id                 String   @id @default(uuid())
  accountId          String   @unique
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  depositAmount      Float
  tenureMonths       Int
  interestRate       Float
  maturityDate       String   // YYYY-MM-DD
  maturityAmount     Float
  installmentAmount  Float?   // For Recurring Deposits
  frequency          String?  @default("MONTHLY") // For RD
  payoutType         String   @default("ON_MATURITY") // ON_MATURITY, MONTHLY_INTEREST, QUARTERLY_INTEREST
  autoRenewal        Boolean  @default(false)
  createdAt          DateTime @default(now())
}

// -------------------------------------------------------------
// 7. PHASE 2: TELLER, CASH & TRANSACTION POSTING ENGINE (SECTIONS 7, 8, 21)
// -------------------------------------------------------------

model TellerTill {
  id                    String            @id @default(uuid())
  branchId              String
  branch                Branch            @relation(fields: [branchId], references: [id])
  userId                String
  user                  User              @relation(fields: [userId], references: [id])
  counterId             String?
  counter               BranchCounter?    @relation(fields: [counterId], references: [id])
  businessDate          String            // YYYY-MM-DD
  openingBalance        Float             @default(0.0)
  totalCashReceived     Float             @default(0.0)
  totalCashPaid         Float             @default(0.0)
  currentBalance        Float             @default(0.0)
  closingBalance        Float?
  shortageExcess        Float?            @default(0.0)
  status                String            @default("OPEN") // OPEN, BALANCED, CLOSED
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  supervisorApprovedBy  String?
  transactions          Transaction[]
}

model Transaction {
  id                    String              @id @default(uuid())
  transactionReference  String              @unique // TXN-YYYYMMDD-XXXXX
  transactionType       String              // CASH_DEPOSIT, CASH_WITHDRAWAL, INTERNAL_TRANSFER, INTEREST_CREDIT
  channel               String              @default("BRANCH_TELLER") // BRANCH_TELLER, ONLINE, SYSTEM
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  businessDate          String              // YYYY-MM-DD
  sourceAccountId       String?
  sourceAccount         Account?            @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccountId  String?
  destinationAccount    Account?            @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  amount                Float
  currency              String              @default("INR")
  narration             String
  status                String              @default("POSTED") // POSTED, REVERSED
  makerUserId           String
  makerUser             User                @relation("TransactionMaker", fields: [makerUserId], references: [id])
  checkerUserId         String?
  checkerUser           User?               @relation("TransactionChecker", fields: [checkerUserId], references: [id])
  tellerTillId          String?
  tellerTill            TellerTill?         @relation(fields: [tellerTillId], references: [id])
  denomination          CashDenomination?
  journalLines          TransactionLine[]
  createdAt             DateTime            @default(now())
}

model TransactionLine {
  id              String      @id @default(uuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account?    @relation(fields: [accountId], references: [id])
  glAccountCode   String      // e.g. GL-1001 (Cash In Hand), GL-2001 (Customer Deposit Liability)
  glAccountName   String
  entryType       String      // DEBIT, CREDIT
  amount          Float
  businessDate    String      // YYYY-MM-DD
  createdAt       DateTime    @default(now())
}

model CashDenomination {
  id              String      @id @default(uuid())
  transactionId   String      @unique
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  note2000        Int         @default(0)
  note500         Int         @default(0)
  note200         Int         @default(0)
  note100         Int         @default(0)
  note50          Int         @default(0)
  note20          Int         @default(0)
  note10          Int         @default(0)
  coins           Int         @default(0)
  totalAmount     Float
}

// -------------------------------------------------------------
// 8. AUDIT TRAIL & SYSTEM CONFIGURATION
// -------------------------------------------------------------

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  username        String
  userRole        String
  branchId        String?
  action          String
  entityName      String
  entityId        String?
  beforeStateJson String?
  afterStateJson  String?
  ipAddress       String?
  userAgent       String?
  businessDate    String?
  timestamp       DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String
  category    String
  isEditable  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

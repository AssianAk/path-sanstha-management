datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. IDENTITY & RBAC
// -------------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdCustomers    Customer[]        @relation("CustomerCreatedBy")
  approvedCustomers   Customer[]        @relation("CustomerApprovedBy")
  makerRequests       ApprovalQueue[]   @relation("MakerRequests")
  checkerRequests     ApprovalQueue[]   @relation("CheckerRequests")
  assignedCounters    BranchCounter[]
  tellerTills         TellerTill[]
  makerTransactions   Transaction[]     @relation("TransactionMaker")
  checkerTransactions Transaction[]   @relation("TransactionChecker")
  sanctionedLoans     LoanApplication[] @relation("LoanSanctionedBy")
  assignedLoans       LoanAccount[]     @relation("AssignedCollector")
  recoveryActions     LoanRecoveryAction[]
  generatedNotices    LoanNotice[]
}

// -------------------------------------------------------------
// 2. ORGANIZATION & BRANCH STRUCTURE
// -------------------------------------------------------------

model Organization {
  id                 String   @id @default(uuid())
  name               String
  registrationNumber String   @unique
  headOfficeAddress  String
  contactEmail       String
  contactPhone       String
  panNumber          String?
  gstNumber          String?
  establishedDate    DateTime?
  branches           Branch[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Branch {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  code             String            @unique
  name             String
  ifscCode         String?
  micrCode         String?
  address          String
  city             String
  state            String
  pincode          String
  phone            String
  email            String
  isActive         Boolean           @default(true)
  users            User[]
  counters         BranchCounter[]
  businessDates    BusinessDate[]
  customers        Customer[]
  approvalQueues   ApprovalQueue[]
  accounts         Account[]
  tellerTills      TellerTill[]
  transactions     Transaction[]
  loanApplications LoanApplication[]
  loanAccounts     LoanAccount[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BranchCounter {
  id            String       @id @default(uuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counterNumber String
  counterName   String
  assignedUserId String?
  assignedUser  User?        @relation(fields: [assignedUserId], references: [id])
  isActive      Boolean      @default(true)
  tellerTills   TellerTill[]
  createdAt     DateTime     @default(now())
}

model BusinessDate {
  id              String    @id @default(uuid())
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentDate     String    // YYYY-MM-DD
  status          String    @default("OPEN") // OPEN, CUTOFF, CLOSED
  openedByUserId  String?
  closedByUserId  String?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?

  @@unique([branchId, currentDate])
}

// -------------------------------------------------------------
// 3. CUSTOMER & MEMBER MASTER
// -------------------------------------------------------------

model Customer {
  id                 String            @id @default(uuid())
  customerNumber     String            @unique
  customerType       String            @default("INDIVIDUAL")
  isMember           Boolean           @default(false)
  memberNumber       String?           @unique
  membershipDate     DateTime?
  memberStatus       String?
  
  title              String            @default("Mr.")
  firstName          String
  middleName         String?
  lastName           String
  dob                String
  gender             String
  maritalStatus      String?
  fatherOrSpouseName String?
  occupation         String?
  annualIncome       Float?            @default(0)
  pan                String?
  aadhaarLast4       String?
  phone              String
  email              String?

  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id])
  riskCategory       String            @default("LOW")
  status             String            @default("PENDING_KYC")

  createdByUserId    String?
  createdBy          User?             @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId   String?
  approvedBy         User?             @relation("CustomerApprovedBy", fields: [approvedByUserId], references: [id])

  passwordHash       String?
  mpin               String?

  addresses          CustomerAddress[]
  nominees           CustomerNominee[]
  kycDocuments       KycDocument[]
  memberShares       MemberShare[]
  accounts           Account[]
  loanApplications   LoanApplication[]
  loanAccounts       LoanAccount[]
  notifications      NotificationLog[]
  standingInstructions StandingInstruction[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pincode     String
  isPrimary   Boolean  @default(true)
}

model CustomerNominee {
  id                   String   @id @default(uuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                 String
  relationship         String
  dob                  String?
  age                  Int?
  phone                String?
  address              String?
  allocationPercentage Float    @default(100.0)
  isMinor              Boolean  @default(false)
  guardianName         String?
  guardianRelation     String?
  guardianPhone        String?
}

model MemberShare {
  id                     String   @id @default(uuid())
  customerId             String
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shareCertificateNumber String   @unique
  distinctFrom           Int
  distinctTo             Int
  totalShares            Int
  faceValue              Float    @default(100.0)
  totalAmount            Float
  issueDate              DateTime @default(now())
  status                 String   @default("ACTIVE")
}

model KycDocument {
  id                  String    @id @default(uuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType        String
  documentNumber      String
  documentUrl         String?   @db.Text
  mimeType            String?   @default("application/pdf")
  version             Int       @default(1)
  status              String    @default("PENDING")
  verifiedByUserId    String?
  verifiedAt          DateTime?
  verificationRemarks String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ApprovalQueue {
  id            String    @id @default(uuid())
  module        String    // CUSTOMER, KYC, MEMBER, ACCOUNT, LOAN, TRANSACTION
  entityId      String
  actionType    String
  payloadJson   String    @db.Text
  status        String    @default("PENDING")
  makerUserId   String
  maker         User      @relation("MakerRequests", fields: [makerUserId], references: [id])
  makerRemarks  String?   @db.Text
  checkerUserId String?
  checker       User?     @relation("CheckerRequests", fields: [checkerUserId], references: [id])
  checkerRemarks String?  @db.Text
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
}

// -------------------------------------------------------------
// 4. PHASE 2: PRODUCTS, CASA & DEPOSITS
// -------------------------------------------------------------

model Product {
  id                    String    @id @default(uuid())
  code                  String    @unique
  name                  String
  category              String
  description           String?
  currency              String    @default("INR")
  minBalance            Float     @default(500.0)
  interestRate          Float     @default(0.0)
  compoundingFrequency  String    @default("QUARTERLY")
  tenureMinMonths       Int?      @default(0)
  tenureMaxMonths       Int?      @default(120)
  prematurePenaltyRate  Float?    @default(1.0)
  glAccountCode         String
  isActive              Boolean   @default(true)
  accounts              Account[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Account {
  id                    String              @id @default(uuid())
  accountNumber         String              @unique
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id])
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  currency              String              @default("INR")
  ledgerBalance         Float               @default(0.0)
  availableBalance      Float               @default(0.0)
  lienAmount            Float               @default(0.0)
  status                String              @default("ACTIVE")
  openedDate            DateTime            @default(now())
  closedDate            DateTime?
  interestAccrued       Float               @default(0.0)
  nomineeName           String?
  nomineeRelation       String?
  termDepositDetail     TermDepositDetail?
  sourceTransactions    Transaction[]       @relation("SourceAccount")
  destTransactions      Transaction[]       @relation("DestinationAccount")
  transactionLines      TransactionLine[]
  disbursedLoans        LoanAccount[]       @relation("LoanSavingsCredit")
  sourceStandingInstructions StandingInstruction[] @relation("SourceAccountSI")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model TermDepositDetail {
  id                 String   @id @default(uuid())
  accountId          String   @unique
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  depositAmount      Float
  tenureMonths       Int
  interestRate       Float
  maturityDate       String
  maturityAmount     Float
  installmentAmount  Float?
  frequency          String?  @default("MONTHLY")
  payoutType         String   @default("ON_MATURITY")
  autoRenewal        Boolean  @default(false)
  createdAt          DateTime @default(now())
}

// -------------------------------------------------------------
// 5. PHASE 2: TELLER & CASH OPERATIONS
// -------------------------------------------------------------

model TellerTill {
  id                    String            @id @default(uuid())
  branchId              String
  branch                Branch            @relation(fields: [branchId], references: [id])
  userId                String
  user                  User              @relation(fields: [userId], references: [id])
  counterId             String?
  counter               BranchCounter?    @relation(fields: [counterId], references: [id])
  businessDate          String
  openingBalance        Float             @default(0.0)
  totalCashReceived     Float             @default(0.0)
  totalCashPaid         Float             @default(0.0)
  currentBalance        Float             @default(0.0)
  closingBalance        Float?
  shortageExcess        Float?            @default(0.0)
  status                String            @default("OPEN")
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  supervisorApprovedBy  String?
  transactions          Transaction[]
}

model Transaction {
  id                    String              @id @default(uuid())
  transactionReference  String              @unique
  transactionType       String              // CASH_DEPOSIT, CASH_WITHDRAWAL, INTERNAL_TRANSFER, LOAN_DISBURSEMENT, LOAN_REPAYMENT
  channel               String              @default("BRANCH_TELLER")
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  businessDate          String
  sourceAccountId       String?
  sourceAccount         Account?            @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccountId  String?
  destinationAccount    Account?            @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  amount                Float
  currency              String              @default("INR")
  narration             String
  status                String              @default("POSTED")
  makerUserId           String
  makerUser             User                @relation("TransactionMaker", fields: [makerUserId], references: [id])
  checkerUserId         String?
  checkerUser           User?               @relation("TransactionChecker", fields: [checkerUserId], references: [id])
  tellerTillId          String?
  tellerTill            TellerTill?         @relation(fields: [tellerTillId], references: [id])
  denomination          CashDenomination?
  journalLines          TransactionLine[]
  loanAllocations       LoanPaymentAllocation[]
  createdAt             DateTime            @default(now())
}

model TransactionLine {
  id              String      @id @default(uuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account?    @relation(fields: [accountId], references: [id])
  glAccountCode   String
  glAccountName   String
  entryType       String      // DEBIT, CREDIT
  amount          Float
  businessDate    String
  createdAt       DateTime    @default(now())
}

model CashDenomination {
  id              String      @id @default(uuid())
  transactionId   String      @unique
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  note2000        Int         @default(0)
  note500         Int         @default(0)
  note200         Int         @default(0)
  note100         Int         @default(0)
  note50          Int         @default(0)
  note20          Int         @default(0)
  note10          Int         @default(0)
  coins           Int         @default(0)
  totalAmount     Float
}

// -------------------------------------------------------------
// 6. PHASE 3: LOANS & ADVANCES (SECTIONS 10, 11, 20)
// -------------------------------------------------------------

model LoanProduct {
  id                    String            @id @default(uuid())
  code                  String            @unique // PL001, GL001, BL001, VL001, AG001
  name                  String
  category              String            // PERSONAL, GOLD, BUSINESS, VEHICLE, MORTGAGE, AGRICULTURAL
  description           String?
  interestRate          Float             // Annual rate percentage (e.g. 11.5%)
  interestType          String            @default("REDUCING_BALANCE") // REDUCING_BALANCE, FLAT
  minAmount             Float             @default(10000.0)
  maxAmount             Float             @default(5000000.0)
  minTenureMonths       Int               @default(6)
  maxTenureMonths       Int               @default(84)
  processingFeePercent  Float             @default(1.0)
  glAssetCode           String            @default("GL-1002") // Loan Principal Asset
  glIncomeCode          String            @default("GL-4001") // Interest Income
  isActive              Boolean           @default(true)
  applications          LoanApplication[]
  loanAccounts          LoanAccount[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model LoanApplication {
  id                    String            @id @default(uuid())
  applicationNumber     String            @unique // LA-YYYY-XXXXX
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  loanProductId         String
  loanProduct           LoanProduct       @relation(fields: [loanProductId], references: [id])
  branchId              String
  branch                Branch            @relation(fields: [branchId], references: [id])
  requestedAmount       Float
  requestedTenureMonths Int
  purpose               String
  status                String            @default("SUBMITTED") // SUBMITTED, APPRAISED, SANCTIONED, REJECTED, DISBURSED
  riskGrade             String?           // GRADE_A, GRADE_B, GRADE_C
  appraisalNotes        String?
  sanctionedAmount      Float?
  sanctionedTenureMonths Int?
  interestRate          Float?
  sanctionedAt          DateTime?
  sanctionedByUserId    String?
  sanctionedBy          User?             @relation("LoanSanctionedBy", fields: [sanctionedByUserId], references: [id])
  rejectionReason       String?
  guarantors            LoanGuarantor[]
  collaterals           LoanCollateral[]
  loanAccount           LoanAccount?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model LoanGuarantor {
  id                String          @id @default(uuid())
  loanApplicationId String
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  name              String
  relationship      String
  phone             String
  pan               String?
  occupation        String?
  netWorth          Float?          @default(0.0)
  address           String?
}

model LoanCollateral {
  id                String          @id @default(uuid())
  loanApplicationId String
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  collateralType    String          // PROPERTY, GOLD, VEHICLE, FD_LIEN, SHARES
  description       String
  marketValue       Float
  assessedValue     Float
  documentRef       String?
}

model LoanAccount {
  id                    String              @id @default(uuid())
  loanAccountNumber     String              @unique // LN-YYYY-XXXXX
  loanApplicationId     String              @unique
  loanApplication       LoanApplication     @relation(fields: [loanApplicationId], references: [id])
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id])
  loanProductId         String
  loanProduct           LoanProduct         @relation(fields: [loanProductId], references: [id])
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  sanctionedAmount      Float
  disbursedAmount       Float
  principalOutstanding  Float
  interestRate          Float
  interestType          String              @default("REDUCING_BALANCE")
  tenureMonths          Int
  emiAmount             Float
  disbursementDate      String              // YYYY-MM-DD
  firstEmiDate          String              // YYYY-MM-DD
  maturityDate          String              // YYYY-MM-DD
  status                String              @default("ACTIVE") // ACTIVE, OVERDUE, NPA, CLOSED
  dpd                   Int                 @default(0) // Days Past Due
  assetClassification   String              @default("STANDARD") // STANDARD, SMA_0, SMA_1, SMA_2, SUB_STANDARD, DOUBTFUL_1, DOUBTFUL_2, DOUBTFUL_3, LOSS
  npaDate               String?             // YYYY-MM-DD
  provisionAmount       Float               @default(0.0)
  provisionPercent      Float               @default(0.4)
  assignedCollectorId   String?
  assignedCollector     User?               @relation("AssignedCollector", fields: [assignedCollectorId], references: [id])
  savingsAccountId      String?
  savingsAccount        Account?            @relation("LoanSavingsCredit", fields: [savingsAccountId], references: [id])
  totalInterestPaid     Float               @default(0.0)
  totalPrincipalPaid    Float               @default(0.0)
  totalPenaltyPaid      Float               @default(0.0)
  installments          LoanInstallment[]
  allocations           LoanPaymentAllocation[]
  recoveryActions       LoanRecoveryAction[]
  notices               LoanNotice[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model LoanInstallment {
  id                    String          @id @default(uuid())
  loanAccountId         String
  loanAccount           LoanAccount     @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  installmentNumber     Int
  dueDate               String          // YYYY-MM-DD
  principalDue          Float
  interestDue           Float
  totalEmi              Float
  principalPaid         Float           @default(0.0)
  interestPaid          Float           @default(0.0)
  penaltyDue            Float           @default(0.0)
  penaltyPaid           Float           @default(0.0)
  status                String          @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE
  paidDate              String?
}

model LoanPaymentAllocation {
  id                      String      @id @default(uuid())
  transactionId           String
  transaction             Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  loanAccountId           String
  loanAccount             LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  installmentId           String?
  totalAmount             Float
  allocatedCharges        Float       @default(0.0)
  allocatedPenalty        Float       @default(0.0)
  allocatedOverdueInterest Float      @default(0.0)
  allocatedCurrentInterest Float      @default(0.0)
  allocatedPrincipal      Float       @default(0.0)
  createdAt               DateTime    @default(now())
}

// -------------------------------------------------------------
// 7. PHASE 4: COLLECTIONS, RECOVERY & NPA (SECTIONS 11, 12, 24)
// -------------------------------------------------------------

model LoanRecoveryAction {
  id                  String      @id @default(uuid())
  loanAccountId       String
  loanAccount         LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  collectorId         String
  collector           User        @relation(fields: [collectorId], references: [id])
  actionType          String      // PHONE_CALL, FIELD_VISIT, BRANCH_MEETING, GUARANTOR_CONTACT, LEGAL_MEETING
  actionDate          String      // YYYY-MM-DD
  customerResponse    String?     // WILL_PAY, DISPUTED, REFUSED, NOT_CONTACTABLE, FINANCIAL_DISTRESS
  promisedPaymentDate String?     // YYYY-MM-DD
  promisedAmount      Float?
  notes               String
  followUpDate        String?     // YYYY-MM-DD
  businessDate        String      // YYYY-MM-DD
  createdAt           DateTime    @default(now())
}

model LoanNotice {
  id                  String      @id @default(uuid())
  noticeNumber        String      @unique // NOT-YYYY-XXXXX
  loanAccountId       String
  loanAccount         LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  noticeType          String      // REMINDER_1, DEMAND_2, FINAL_RECALL_3, SEC_101_COOP, SEC_138_NI
  generatedDate       String      // YYYY-MM-DD
  dueAmount           Float
  principalOverdue    Float
  interestOverdue     Float
  penalCharges        Float
  dispatchMedium      String      @default("REGISTERED_POST") // REGISTERED_POST, SPEED_POST, HAND_DELIVERY, SMS_EMAIL
  dispatchRef         String?
  dispatchedDate      String?
  deliveryStatus      String      @default("GENERATED") // GENERATED, DISPATCHED, DELIVERED, RETURNED, REPLIED
  deliveredDate       String?
  content             String?     @db.Text
  generatedByUserId   String
  generatedByUser     User        @relation(fields: [generatedByUserId], references: [id])
  businessDate        String      // YYYY-MM-DD
  createdAt           DateTime    @default(now())
}

// -------------------------------------------------------------
// 8. PHASE 5: GENERAL LEDGER & CHART OF ACCOUNTS (SECTION 21)
// -------------------------------------------------------------

model GLAccount {
  id              String      @id @default(uuid())
  code            String      @unique // GL-1001, GL-2001, GL-3001, GL-4001, GL-5001
  name            String
  category        String      // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  parentCode      String?
  normalBalance   String      // DEBIT, CREDIT
  description     String?
  isLeaf          Boolean     @default(true)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// -------------------------------------------------------------
// 9. AUDIT TRAIL & SYSTEM CONFIGURATION
// -------------------------------------------------------------

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  username        String
  userRole        String
  branchId        String?
  action          String
  entityName      String
  entityId        String?
  beforeStateJson String?  @db.Text
  afterStateJson  String?  @db.Text
  ipAddress       String?
  userAgent       String?
  businessDate    String?
  timestamp       DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String
  category    String
  isEditable  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 10. PHASE 7: DIGITAL CHANNELS, NOTIFICATIONS & E-MANDATES
// -------------------------------------------------------------

model NotificationLog {
  id              String   @id @default(uuid())
  recipientPhone  String
  recipientEmail  String?
  channel         String   // SMS, WHATSAPP, EMAIL
  category        String   // TRANSACTION, ALERT, REMINDER, NOTICE, OTP
  templateCode    String
  title           String
  message         String   @db.Text
  status          String   @default("SENT") // QUEUED, SENT, DELIVERED, FAILED
  deliveryRef     String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  businessDate    String   // YYYY-MM-DD
  createdAt       DateTime @default(now())
}

model StandingInstruction {
  id                  String                  @id @default(uuid())
  mandateNumber       String                  @unique // SI-YYYY-XXXXX
  customerId          String
  customer            Customer                @relation(fields: [customerId], references: [id])
  sourceAccountId     String
  sourceAccount       Account                 @relation("SourceAccountSI", fields: [sourceAccountId], references: [id])
  instructionType     String                  // RECURRING_DEPOSIT, LOAN_EMI, INTERNAL_TRANSFER
  targetAccountId     String?
  targetLoanId        String?
  amount              Float
  frequency           String                  @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  executionDay        Int                     @default(1) // 1 to 31
  startDate           String                  // YYYY-MM-DD
  endDate             String?                 // YYYY-MM-DD
  nextExecutionDate   String                  // YYYY-MM-DD
  lastExecutedDate    String?                 // YYYY-MM-DD
  status              String                  @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CANCELLED
  failureCount        Int                     @default(0)
  executionLogs       StandingInstructionLog[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model StandingInstructionLog {
  id                    String              @id @default(uuid())
  standingInstructionId String
  standingInstruction   StandingInstruction @relation(fields: [standingInstructionId], references: [id], onDelete: Cascade)
  executionDate         String              // YYYY-MM-DD
  amount                Float
  status                String              // SUCCESS, FAILED, SKIPPED_INSUFFICIENT_FUNDS
  transactionReference  String?
  failureReason         String?
  createdAt             DateTime            @default(now())
}

model DigitalPaymentRequest {
  id                          String    @id @default(uuid())
  paymentReference            String    @unique // PAY-YYYY-XXXXX
  upiIntentUrl                String    @db.Text
  qrData                      String    @db.Text
  customerId                  String?
  accountNumber               String?
  loanAccountNumber           String?
  purpose                     String    // SAVINGS_DEPOSIT, SHARE_CAPITAL, LOAN_REPAYMENT, RD_INSTALLMENT
  amount                      Float
  utrNumber                   String?
  status                      String    @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED
  settledTransactionReference String?
  businessDate                String    // YYYY-MM-DD
  createdAt                   DateTime  @default(now())
  settledAt                   DateTime?
}

